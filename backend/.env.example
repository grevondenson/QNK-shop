# ──────────────────────────────────────────
# QNK Noire Bags — Backend environment
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# MongoDB
# Use a replica set URI so multi-document transactions work.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qnk_noire_bags?retryWrites=true&w=majority

# Auth / sessions
# Generate a strong random secret: `openssl rand -hex 64`
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Admin credentials (used only for initial seed; remove from env in production)
ADMIN_EMAIL=admin@qnknoire.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Cloudinary (image CDN)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Payment provider — M-Pesa (primary candidate for Kenya market)
# Confirm merchant eligibility before populating these.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://<your-domain>/api/order/mpesa/callback
MPESA_ENV=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
SHIPPING_FEE_MINOR=5000
RESERVATION_MINUTES=15

# Payment provider — Stripe (secondary / international)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=orders@qnknoire.com

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Feature flags
REQUIRE_ADMIN_MFA=false
