# ──────────────────────────────────────────
# QNK Noire Bags — Frontend (Storefront) environment
# Copy to .env and fill in your values.
# ──────────────────────────────────────────

# Base URL of the Express API (no trailing slash)
VITE_BACKEND_URL=http://localhost:4000

# Public Stripe key (publishable, safe for frontend)
VITE_STRIPE_PUBLIC_KEY=

# App display name — used in meta tags and page titles
VITE_STORE_NAME=QNK Noire Bags

# Analytics (optional — add once baseline is established)
VITE_GA_MEASUREMENT_ID=
